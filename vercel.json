{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "missing": [{ "type": "query", "key": "studio" }],
      "destination": "/?studio=1",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
