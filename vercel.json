{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "missing": [
        { "type": "query", "key": "studio" },
        { "type": "query", "key": "view" },
        { "type": "query", "key": "mode" },
        { "type": "query", "key": "totem" }
      ],
      "destination": "/?view=map&orientation=vertical",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
